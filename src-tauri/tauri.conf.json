{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "kaif-browser",
  "version": "0.1.0",
  "identifier": "com.danil.kaif-browser",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "???????????",
        "fullscreen": false,
        "resizable": true,
        "width": 1280,
        "height": 800,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": false,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self' 'unsafe-inline' 'unsafe-eval' https: data: blob:;"
    }
  }
}