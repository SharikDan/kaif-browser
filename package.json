{
  "name": "kaif-browser",
  "version": "11.2.0",
  "description": "KaifBrowser - Modern Browser",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win --publish=never"
  },
  "author": "Danil",
  "license": "MIT",
  "devDependencies": {
    "electron": "29.0.0",
    "electron-builder": "24.13.3"
  },
  "build": {
    "appId": "com.danil.kaifbrowser",
    "productName": "KaifBrowser",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}