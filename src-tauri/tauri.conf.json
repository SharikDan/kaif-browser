{
    "$schema":  "https://schema.tauri.app/config/2",
    "productName":  "kaif-browser",
    "version":  "1.0.0",
    "identifier":  "com.danil.kaif-browser",
    "build":  {
                  "beforeDevCommand":  "npm run dev",
                  "devUrl":  "http://localhost:5173",
                  "beforeBuildCommand":  "npm run build",
                  "frontendDist":  "../dist"
              },
    "app":  {
                "windows":  [
                                {
                                    "title":  "КайфБраузер",
                                    "fullscreen":  false,
                                    "resizable":  true,
                                    "width":  1280,
                                    "height":  800,
                                    "decorations":  true,
                                    "transparent":  false,
                                    "alwaysOnTop":  false,
                                    "visible":  true
                                }
                            ],
                "security":  {
                                 "csp":  "default-src \u0027self\u0027 \u0027unsafe-inline\u0027 \u0027unsafe-eval\u0027 https: data: blob:;"
                             }
            },
    "bundle":  {
                   "active":  true,
                   "icon":  [
                                "icons/32x32.png",
                                "icons/128x128.png",
                                "icons/128x128@2x.png",
                                "icons/icon.icns",
                                "icons/icon.ico"
                            ],
                   "windows":  {
                                   "nsis":  {
                                                "installMode":  "currentUser",
                                                "languages":  [
                                                                  "Russian",
                                                                  "English"
                                                              ],
                                                "displayLanguageSelector":  true
                                            }
                               }
               }
}